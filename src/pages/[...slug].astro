---
export const prerender = false;
// Every built page is bundled as a raw string at build time; the catch all serves it server side so
// subpages never hit the trailing slash redirect loop.
const files = import.meta.glob('../site/**/index.html', { query: '?raw', import: 'default', eager: true });
const map = {};
for (const p in files) { let r = p.replace('../site', '').replace(/index\.html$/, ''); if (r === '') r = '/'; map[r] = files[p]; }
const redirects = { '/terms/': '/terms-of-service/', '/privacy/': '/privacy-policy/', '/products/': '/plans/', '/confirmation/': '/checkout/confirmed/' };
let path = new URL(Astro.request.url).pathname;
if (!path.endsWith('/')) path += '/';
if (redirects[path]) return Astro.redirect(redirects[path], 301);
const found = map[path];
let html = found || map['/404/'] || map['/'];
// og:image and twitter:image are authored site relative; they are made absolute here with the public origin the page
// was served from, so crawlers can always fetch them. Order: PUBLIC_ORIGIN when set (build time import.meta.env, or
// the Cloudflare adapter's runtime env on Astro.locals, both guarded); else, when the resolved host is Webflow Cloud's
// internal wf-app-prod.cosmic.webflow.services (which both X-Forwarded-Host and Host carry there), the public
// webflow.io origin; else the forwarded host, then Host, then the request URL, scheme https (http only for a loopback
// host, so the local preview keeps referencing itself).
let envOrigin = '';
try { envOrigin = (import.meta.env && import.meta.env.PUBLIC_ORIGIN) || ''; } catch (e) { envOrigin = ''; }
try { const rt = Astro.locals && Astro.locals.runtime; if (!envOrigin && rt && rt.env && rt.env.PUBLIC_ORIGIN) envOrigin = rt.env.PUBLIC_ORIGIN; } catch (e) { /* no runtime env on this adapter */ }
const publicHost = ((Astro.request.headers.get('x-forwarded-host') || Astro.request.headers.get('host') || new URL(Astro.request.url).host) + '').split(',')[0].trim();
const loopback = /^(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$/i.test(publicHost);
let origin;
if (envOrigin) origin = String(envOrigin).replace(/\/+$/, '');
else if (/webflow\.services$/i.test(publicHost) || publicHost.indexOf('webflow.services') !== -1) origin = 'https://astroquanta-site.webflow.io';
else origin = (loopback ? 'http' : 'https') + '://' + publicHost;
html = html.replace(/(<meta (?:property="og:image"|name="twitter:image") content=")(\/assets\/)/g, '$1' + origin + '$2');
// noindex (pass 6): checkout, the confirmation and every 404 carry X-Robots-Tag rather than a meta tag, so the
// crawl directive travels with the response and the pre deploy head scan (which fails on any meta noindex) stays green.
const noindex = !found || path === '/checkout/' || path === '/checkout/confirmed/';
const headers = { 'content-type': 'text/html; charset=utf-8', 'cache-control': found ? 'public, max-age=300' : 'no-store' };
if (noindex) headers['x-robots-tag'] = 'noindex, nofollow';
return new Response(html, { status: found ? 200 : 404, headers });
---
